[sub_resource type="Shader" id="Shader_leftshade"]
code = "shader_type canvas_item;
// a soft dark column down the left of the screen, so the logo and the menu read over whatever the live hall is doing behind them
uniform float width = 0.62;
uniform float strength = 0.86;
void fragment() {
	COLOR = vec4(0.012, 0.010, 0.025, strength * (1.0 - smoothstep(0.0, width, UV.x)));
}
"

